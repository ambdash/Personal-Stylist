# Build stage
FROM python:3.10-slim-bullseye as builder

WORKDIR /app

# Configure apt and install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libc6-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy only requirements first to leverage Docker cache
COPY requirements.txt pyproject.toml poetry.lock ./

# Create virtual environment and install dependencies
RUN python -m venv /opt/venv && \
    . /opt/venv/bin/activate && \
    pip install --no-cache-dir -r requirements.txt

# Final stage
FROM python:3.10-slim-bullseye

WORKDIR /app

# Install only runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder stage
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Create model directories
RUN mkdir -p /app/models/finetuned/t_lite

# Copy project files
COPY src/ src/
COPY data/ data/
COPY scripts/ scripts/

# Copy Neo4j data files
COPY src/api/db/neo4j/new_nodes.csv /app/src/api/db/neo4j/
COPY src/api/db/neo4j/new_edges.csv /app/src/api/db/neo4j/
COPY src/api/db/neo4j/clean_and_transform.cypher /app/src/api/db/neo4j/

# Set environment variables
ENV PYTHONPATH=/app \
    PORT=8002 \
    PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc \
    PROMETHEUS_DIR=/tmp/prometheus \
    MODEL_PATH=/app/models

# Create directories with proper permissions
RUN mkdir -p /tmp/prometheus_multiproc /tmp/prometheus && \
    chmod -R 777 /tmp/prometheus_multiproc /tmp/prometheus /app/models

# Create non-root user
RUN useradd -m myuser && \
    chown -R myuser:myuser /app /tmp/prometheus_multiproc /tmp/prometheus
USER myuser

# Health check
COPY --chown=myuser:myuser docker/healthcheck.sh /app/healthcheck.sh
RUN chmod +x /app/healthcheck.sh

# Create initialization script
COPY --chown=myuser:myuser docker/init.sh /app/init.sh
RUN chmod +x /app/init.sh

# Expose port
EXPOSE 8002

# Start command with initialization
CMD ["/bin/bash", "-c", "/app/init.sh && python -m uvicorn src.api.main:app --host 0.0.0.0 --port 8002"]
