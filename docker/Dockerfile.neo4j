FROM neo4j:5.15

# Install Python and pip
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip3 install neo4j==5.7.0 pathlib

# Create directories and set permissions
RUN mkdir -p /var/lib/neo4j/import && \
    mkdir -p /var/lib/neo4j/conf && \
    chown -R neo4j:neo4j /var/lib/neo4j && \
    chmod -R 777 /var/lib/neo4j/import

# Copy Neo4j configuration
COPY src/neo4j/neo4j.conf /var/lib/neo4j/conf/
COPY src/neo4j/apoc.conf /var/lib/neo4j/conf/
RUN chown neo4j:neo4j /var/lib/neo4j/conf/neo4j.conf && \
    chown neo4j:neo4j /var/lib/neo4j/conf/apoc.conf && \
    chmod 644 /var/lib/neo4j/conf/neo4j.conf && \
    chmod 644 /var/lib/neo4j/conf/apoc.conf

# Copy data files
COPY src/api/db/neo4j/new_nodes.csv /var/lib/neo4j/import/
COPY src/api/db/neo4j/new_edges.csv /var/lib/neo4j/import/
COPY src/api/db/neo4j/clean_and_transform.cypher /var/lib/neo4j/import/

# Copy initialization script
COPY src/api/db/neo4j/init_docker.py /var/lib/neo4j/import/

# Copy initialization script
COPY docker/init.sh /var/lib/neo4j/
RUN chmod +x /var/lib/neo4j/init.sh

# Install APOC plugin
RUN wget -O /var/lib/neo4j/plugins/apoc-5.15.0-core.jar \
    https://github.com/neo4j-contrib/neo4j-apoc-procedures/releases/download/5.15.0/apoc-5.15.0-core.jar

# Set environment variables
ENV NEO4J_AUTH=neo4j/password123
ENV NEO4J_PLUGINS=["apoc"]
ENV NEO4J_dbms_security_procedures_unrestricted=apoc.*
ENV NEO4J_dbms_security_procedures_allowlist=apoc.*
ENV NEO4J_dbms_memory_heap_initial__size=1G
ENV NEO4J_dbms_memory_heap_max__size=2G

# Expose ports
EXPOSE 7474 7687

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=5 \
    CMD curl -f http://localhost:7474 || exit 1

# Set the entrypoint to run initialization
ENTRYPOINT ["/var/lib/neo4j/init.sh"]