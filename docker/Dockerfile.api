# Build stage
FROM python:3.10-slim-bullseye as builder

WORKDIR /app

# Configure apt and install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libc6-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy only requirements first to leverage Docker cache
COPY requirements.txt pyproject.toml poetry.lock ./

# Create virtual environment and install dependencies
RUN python -m venv /opt/venv && \
    . /opt/venv/bin/activate && \
    pip install --no-cache-dir -r requirements.txt

# Final stage
FROM python:3.10-slim-bullseye

WORKDIR /app

# Install only runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder stage
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy project files
COPY src/ src/
COPY data/ data/

# Set environment variables
ENV PYTHONPATH=/app \
    PORT=8000 \
    PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc \
    PROMETHEUS_DIR=/tmp/prometheus

# Create directories for Prometheus
RUN mkdir -p /tmp/prometheus_multiproc /tmp/prometheus && \
    chmod 777 /tmp/prometheus_multiproc /tmp/prometheus

# Create non-root user
RUN useradd -m myuser && \
    chown -R myuser:myuser /app /tmp/prometheus_multiproc /tmp/prometheus
USER myuser

# Health check
COPY --chown=myuser:myuser docker/healthcheck.sh /app/healthcheck.sh
RUN chmod +x /app/healthcheck.sh

# Expose port
EXPOSE 8000

# Start command
CMD ["python", "-m", "uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
